# systemd service: make one short video (rendered only, not uploaded, by default).
# Started by autoshorts.timer (3x a day). deploy/install.sh copies this file to
# /etc/systemd/system/ with the paths and user filled in; to install it by hand:
#
#   sudo cp deploy/autoshorts.service deploy/autoshorts.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start autoshorts.service      # one test run now
#   journalctl -u autoshorts.service -e          # its log
#   sudo systemctl enable --now autoshorts.timer # then let the timer take over
#
# Uploading: the default command only renders (--no-upload). Until your Google API
# project passes YouTube's audit, every API upload is locked private for good (README,
# "YouTube upload setup"), so review the videos in output/ and publish the good ones with
# `autoshorts upload <job folder> --to youtube`. Once the project is audited, turn uploads
# on with a drop-in override (it survives re-running install.sh):
#
#   sudo systemctl edit autoshorts.service
#     [Service]
#     ExecStart=
#     ExecStart=/opt/autoshorts/.venv/bin/autoshorts batch -n 1 --upload youtube
#
# (or --upload youtube,tiktok). Exit code 3 (video made, upload failed) marks the run as
# failed on purpose, so it shows up in `systemctl --failed`.

[Unit]
Description=autoshorts: make one short video
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=autoshorts
Group=autoshorts
WorkingDirectory=/opt/autoshorts
ExecStart=/opt/autoshorts/.venv/bin/autoshorts batch -n 1 --no-upload
Environment=PYTHONUNBUFFERED=1
# fontconfig (captions) keeps its cache here instead of the read-only home folder.
Environment=XDG_CACHE_HOME=/opt/autoshorts/cache/xdg
# Rendering is CPU heavy: keep the rest of the server responsive, and never hang forever.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
# A runaway ffmpeg must not take the whole server down with it.
MemoryMax=75%
# Files the service creates (videos, logs, tokens) are private to its user.
UMask=0077

# Hardening. The code and .venv belong to root (deploy/install.sh); the service may only
# write its data folders, .env (refreshed TikTok tokens), topics.txt and /tmp.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-/opt/autoshorts/output -/opt/autoshorts/cache -/opt/autoshorts/state -/opt/autoshorts/secrets
ReadWritePaths=-/opt/autoshorts/.env -/opt/autoshorts/topics.txt
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
