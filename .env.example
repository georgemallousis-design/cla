# autoshorts secrets
# ------------------
# Copy this file to .env (`autoshorts init` does it for you) and fill in what you use.
# Every key is OPTIONAL: with none of them autoshorts still makes videos (offline script
# bank, free edge-tts voices, generated backgrounds). Keep .env private; never commit it.
# Format: NAME=value  (no quotes, no spaces around "=")

# --- Stock footage (free) ------------------------------------------------------------
# Pexels: sign up, then https://www.pexels.com/api/ -> "Your API key". 200 requests/hour.
PEXELS_API_KEY=

# Pixabay: sign up, then https://pixabay.com/api/docs/ -> your key is shown under "Parameters".
PIXABAY_API_KEY=

# --- Script writer (free tier) -------------------------------------------------------
# Key for script.openai_compatible in config.yaml. Default endpoint is Groq:
#   Groq:          https://console.groq.com/keys
#   Google Gemini: https://aistudio.google.com/apikey  (also change base_url/model in config.yaml)
#   OpenRouter:    https://openrouter.ai/keys           (use a model id ending in ":free")
# Not needed if you run Ollama locally (https://ollama.com).
LLM_API_KEY=

# --- TikTok upload (optional) --------------------------------------------------------
# From your own app at https://developers.tiktok.com (Login Kit + Content Posting API).
# See README "TikTok upload setup"; deploy/tiktok_token.py fetches these for you.
# The access token expires after 24 hours.
TIKTOK_ACCESS_TOKEN=
# With these three set, an expired access token is refreshed automatically
# (refresh tokens last 365 days). Client key/secret: your app's page on developers.tiktok.com.
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube upload uses OAuth files instead of keys:
#   secrets/client_secret.json (from Google Cloud) and secrets/youtube_token.json
#   (written by `autoshorts auth youtube`). See README "YouTube upload setup".
